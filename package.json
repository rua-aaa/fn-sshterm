{
  "name": "sshterm",
  "version": "1.0.0",
  "private": true,
  "description": "SSH xterm web tool inspired by fnpackup (Vue3 + Element Plus + xterm + Node ssh2)",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:web": "node web/node_modules/vite/bin/vite.js --config web/vite.config.js",
    "build:web": "node web/node_modules/vite/bin/vite.js build --config web/vite.config.js",
    "start": "node server/index.js",
    "dev": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ssh2": "^1.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7"
  }
}
